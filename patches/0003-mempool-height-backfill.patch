@@ -53,6 +53,33 @@ pub async fn update_block_height(
     Ok(())
 }
 
+/// Backfill the mined height for a payment that was first observed in
+/// the mempool. The matcher re-polls an invoice address every tick and
+/// re-encounters already-known UTXOs; Blockbook reports `height = 0`
+/// until the tx is mined, so the row inserted at discovery time can
+/// carry 0 forever while the confirmation sweep keeps computing a
+/// depth of 0 (0 = mempool) and the invoice never leaves Confirming.
+/// Only touches rows still at height 0 — mined heights are never
+/// overwritten (reorg handling is the confirmation sweep's job).
+pub async fn backfill_block_height(
+    db: &Db,
+    txid: &str,
+    vout: u32,
+    block_height: u32,
+) -> Result<()> {
+    sqlx::query(
+        "UPDATE payments
+            SET block_height = ?
+          WHERE txid = ? AND vout = ? AND block_height = 0",
+    )
+    .bind(block_height as i64)
+    .bind(txid)
+    .bind(vout as i64)
+    .execute(db.pool())
+    .await?;
+    Ok(())
+}
+
 /// Sum of all observed payment values for an invoice, regardless of
 /// confirmation depth. Drives the underpay/exact/overpay decision in
 /// `next_status_on_payment`.
